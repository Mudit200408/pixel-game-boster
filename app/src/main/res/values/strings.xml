    <!-- OnboardingScreen (onboarding_) -->
    <string name="onboarding_slide1_title">Pixel Game Booster</string>
    <string name="onboarding_slide1_desc">Engineered specifically for Google Pixel devices. Automates physical 120Hz display locking, kernel memory purging, and background app suspension to deliver sustained peak frame rates without thermal throttling.</string>
    <string name="onboarding_slide2_title">120Hz Display Lock</string>
    <string name="onboarding_slide2_desc">Eliminates stutter and frame rate jitter by locking Pixel\'s LTPO display panel to a rock-solid 120Hz hardware refresh rate.\n\nStabilizes physical display panel timing to prevent aggressive 60Hz/30Hz drops without spoofing in-game engine FPS caps.</string>
    <string name="onboarding_slide3_title">Selective App Freezing</string>
    <string name="onboarding_slide3_desc">Suspends resource-heavy background apps using Android\'s native package suspension (`cmd package suspend --user 0`) and temporarily pauses background Google sync.\n\nFrees up RAM and CPU cores exclusively for game rendering without altering or uninstalling your apps.</string>
    <string name="onboarding_btn_skip">Skip</string>
    <string name="onboarding_cd_back">Back</string>
    <string name="onboarding_btn_next">Next</string>
    <string name="onboarding_btn_configure_permissions">Configure Permissions</string>

