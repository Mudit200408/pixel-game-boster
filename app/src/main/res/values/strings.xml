    <!-- NetworkSyncScreen (net_) -->
    <string name="net_header_title">Network &amp; Sync</string>
    <string name="net_section_wifi_latency">Wi-Fi &amp; Latency Optimization</string>
    <string name="net_low_latency_title">Wi-Fi Low Latency Lock</string>
    <string name="net_low_latency_desc">Acquires high-perf Wi-Fi lock and disables Wi-Fi power save throttling.</string>
    <string name="net_low_latency_cmd" translatable="false">WifiLock(LOW_LATENCY) &amp;&amp; settings put global wifi_power_save 0</string>
    <string name="net_suppress_scans_title">Suppress Network Scans</string>
    <string name="net_suppress_scans_desc">Stops background Wi-Fi and Bluetooth beacon scans causing latency spikes.</string>
    <string name="net_suppress_scans_cmd" translatable="false">settings put global wifi_scan_always_enabled 0 &amp;&amp; ble_scan_always_enabled 0</string>
    <string name="net_lock_sufficiency_title">Lock Network Sufficiency</string>
    <string name="net_lock_sufficiency_desc">Disables aggressive Wi-Fi hopping and adaptive connectivity handovers.</string>
    <string name="net_lock_sufficiency_cmd" translatable="false">settings put secure adaptive_connectivity_enabled 0 &amp;&amp; cmd wifi set-network-selection-config enabled enabled -a 0</string>
    <string name="net_prevent_arp_title">Prevent ARP Disconnects</string>
    <string name="net_prevent_arp_desc">Blocks dropping Wi-Fi connection on transient router ARP probe misses.</string>
    <string name="net_prevent_arp_cmd" translatable="false">cmd wifi set-ipreach-disconnect disabled</string>
    <string name="net_disable_private_dns_title">Private DNS Latency Bypass</string>
    <string name="net_disable_private_dns_desc">Disables Private DNS during gaming to avoid DNS query latency spikes.</string>
    <string name="net_disable_private_dns_cmd" translatable="false">settings put global private_dns_mode off</string>
    <string name="net_section_sync">Background Sync</string>
    <string name="net_section_power">Power</string>
    <string name="net_pause_sync_title">Pause Master Auto-Sync</string>
    <string name="net_pause_sync_desc">Halts cloud account synchronization to prevent background disk and network I/O.</string>
    <string name="net_pause_sync_cmd" translatable="false">ContentResolver.setMasterSyncAutomatically(false)</string>
    <string name="net_block_battery_saver_title">Suppress Battery Saver</string>
    <string name="net_block_battery_saver_desc">Bypasses system CPU throttling and preserves maximum frame stability.</string>
    <string name="net_block_battery_saver_cmd" translatable="false">settings put global low_power 0 &amp;&amp; cmd power set-mode 0</string>

