    <!-- ShizukuPairingDialog (dialog_shizuku_) -->
    <string name="dialog_shizuku_title">Shizuku Wireless Pairing</string>
    <string name="dialog_shizuku_desc">Shizuku allows Pixel Game Booster to execute privileged system optimizations via Android\'s native Wireless Debugging without root.</string>
    <string name="dialog_shizuku_step1_title">Enable Developer Options</string>
    <string name="dialog_shizuku_step1_desc">Go to Settings &gt; About Phone, and tap \'Build number\' 7 times until unlocked.</string>
    <string name="dialog_shizuku_step2_title">Enable Wireless Debugging</string>
    <string name="dialog_shizuku_step2_desc">In Developer Options, turn ON \'Wireless Debugging\' while connected to Wi-Fi.</string>
    <string name="dialog_shizuku_step3_title">Pair with 6-digit Code</string>
    <string name="dialog_shizuku_step3_desc">Tap \'Pair device with pairing code\' in Developer Options. Note the pairing code and port number.</string>
    <string name="dialog_shizuku_step4_title">Start Service in Shizuku</string>
    <string name="dialog_shizuku_step4_desc">Open Shizuku app, tap \'Pairing\' to enter the code, then tap \'Start\' to activate the service.</string>
    <string name="dialog_shizuku_adb_title">Alternative: Computer USB ADB Command</string>
    <string name="dialog_shizuku_adb_command" translatable="false">adb shell sh /sdcard/Android/data/moe.shizuku.privileged.api/start.sh</string>
    <string name="dialog_shizuku_btn_open">Open Shizuku</string>
    <string name="dialog_shizuku_btn_dev_options">Dev Options</string>
    <string name="dialog_shizuku_btn_close">Close</string>

