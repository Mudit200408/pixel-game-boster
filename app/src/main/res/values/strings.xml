    <!-- PerformanceDisplayScreen (perf_) -->
    <string name="perf_header_title">Display &amp; Memory</string>
    <string name="perf_section_display_refresh">Display</string>
    <string name="perf_force_120hz_title">Force 120Hz Physical Display Mode</string>
    <string name="perf_force_120hz_desc">Forces physical panel to 120Hz fixed to eliminate 60Hz/30Hz LTPO drops.</string>
    <string name="perf_force_120hz_cmd" translatable="false">cmd display set-user-preferred-display-mode &lt;W&gt; &lt;H&gt; 120 0</string>
    <string name="perf_section_memory_kernel">Memory</string>
    <string name="perf_purge_ram_title">Purge RAM &amp; ZRAM</string>
    <string name="perf_purge_ram_desc">Evicts background cached processes to prevent memory pressure.</string>
    <string name="perf_purge_ram_cmd" translatable="false">am kill-all</string>
    <string name="perf_cached_freezer_title">Kernel Cached Apps Freezer</string>
    <string name="perf_cached_freezer_desc">Freezes background app cgroups to preserve CPU cycles for game threads.</string>
    <string name="perf_cached_freezer_cmd" translatable="false">settings put global cached_apps_freezer enabled</string>
    <string name="perf_section_display_brightness">Display Brightness</string>
    <string name="perf_disable_auto_brightness_title">Disable Auto-Brightness</string>
    <string name="perf_disable_auto_brightness_desc">Locks current brightness to prevent sudden light sensor dips mid-game.</string>
    <string name="perf_disable_auto_brightness_cmd" translatable="false">settings put system screen_brightness_mode 0</string>

    <!-- AppFreezerScreen (freezer_) -->
    <string name="freezer_header_title">App Suspension</string>
    <string name="freezer_section_configured_apps">Configured Applications (%1$d)</string>
    <string name="freezer_empty_title">No Applications Suspended</string>
    <string name="freezer_empty_desc">Select installed apps from the App Selection Sheet below to freeze them during gameplay.</string>
    <string name="freezer_cd_unfreeze">Unfreeze %1$s</string>
    <string name="freezer_section_process_management">Process Management</string>
    <string name="freezer_user_apps_title">User App Freezer</string>
    <string name="freezer_user_apps_desc">Select user applications to suspend while gaming (%1$d apps configured)</string>
    <string name="freezer_user_apps_cmd" translatable="false">cmd package suspend --user 0 &lt;package&gt;</string>
    <string name="freezer_google_services_title">Google Background Services</string>
    <string name="freezer_google_services_desc">Suspends background telemetry, AI Core, and daemons (%1$d services active)</string>
    <string name="freezer_google_services_cmd" translatable="false">pm disable-user --user 0 / cmd package suspend</string>
    <string name="freezer_disable_quick_tap_title">Disable Quick Tap</string>
    <string name="freezer_disable_quick_tap_desc">Suspends rear-tap sensor monitor to eliminate touch latency and input jank.</string>
    <string name="freezer_disable_quick_tap_cmd" translatable="false">settings put secure columbus_enabled 0</string>
    <string name="freezer_warning_prefix">"WARNING: "</string>
    <string name="freezer_warning_desc">Selected apps and Google services will be automatically suspended during gameplay (e.g. Call of Duty: Mobile) and restored on game exit.</string>
    <string name="freezer_warning_full">WARNING: Selected apps and Google services will be automatically suspended during gameplay (e.g. Call of Duty: Mobile) and restored on game exit.</string>

    <!-- NetworkSyncScreen (net_) -->
    <string name="net_header_title">Network &amp; Sync</string>
    <string name="net_section_profile">Optimization Profile</string>
    <string name="net_preset_mode_title">Preset Mode</string>
    <string name="net_preset_mode_desc">Select all-out competitive latency tuning or balanced gaming</string>
    <string name="net_profile_competitive">Competitive</string>
    <string name="net_profile_balanced">Balanced</string>
    <string name="net_section_wifi_latency">Wi-Fi &amp; Latency Optimization</string>
    <string name="net_low_latency_title">Wi-Fi Low Latency Lock</string>
    <string name="net_low_latency_desc">Acquires high-perf Wi-Fi lock and disables Wi-Fi power save throttling.</string>
    <string name="net_low_latency_cmd" translatable="false">WifiLock(LOW_LATENCY) &amp;&amp; settings put global wifi_power_save 0</string>
    <string name="net_suppress_scans_title">Suppress Network Scans</string>
    <string name="net_suppress_scans_desc">Stops background Wi-Fi and Bluetooth beacon scans causing latency spikes.</string>
    <string name="net_suppress_scans_cmd" translatable="false">settings put global wifi_scan_always_enabled 0 &amp;&amp; ble_scan_always_enabled 0</string>
    <string name="net_lock_sufficiency_title">Lock Network Sufficiency</string>
    <string name="net_lock_sufficiency_desc">Disables aggressive Wi-Fi hopping and adaptive connectivity handovers.</string>
    <string name="net_lock_sufficiency_cmd" translatable="false">settings put secure adaptive_connectivity_enabled 0 &amp;&amp; cmd wifi set-network-selection-config enabled enabled -a 0</string>
    <string name="net_prevent_arp_title">Prevent ARP Disconnects</string>
    <string name="net_prevent_arp_desc">Blocks dropping Wi-Fi connection on transient router ARP probe misses.</string>
    <string name="net_prevent_arp_cmd" translatable="false">cmd wifi set-ipreach-disconnect disabled</string>
    <string name="net_disable_private_dns_title">Private DNS Latency Bypass</string>
    <string name="net_disable_private_dns_desc">Disables Private DNS (DoT) during gaming to avoid DNS query latency spikes.</string>
    <string name="net_disable_private_dns_cmd" translatable="false">settings put global private_dns_mode off</string>
    <string name="net_section_sync_power">Background Sync &amp; Power</string>
    <string name="net_pause_sync_title">Pause Master Auto-Sync</string>
    <string name="net_pause_sync_desc">Halts cloud account synchronization to prevent background disk and network I/O.</string>
    <string name="net_pause_sync_cmd" translatable="false">ContentResolver.setMasterSyncAutomatically(false)</string>
    <string name="net_block_battery_saver_title">Suppress Battery Saver</string>
    <string name="net_block_battery_saver_desc">Bypasses system CPU throttling and preserves maximum frame stability.</string>
    <string name="net_block_battery_saver_cmd" translatable="false">settings put global low_power 0 &amp;&amp; cmd power set-mode 0</string>

